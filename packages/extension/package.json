{
  "name": "@meetdeck/extension",
  "version": "0.0.1",
  "description": "Chrome extension that drives Google Meet from the local Stream Deck bridge websocket",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@meetdeck/protocol": "workspace:*"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
