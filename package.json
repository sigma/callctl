{
  "name": "meetdeck-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Stream Deck control surface for Google Meet (plugin + extension + shared protocol)",
  "workspaces": [
    "packages/protocol",
    "packages/plugin",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:plugin": "npm run dev -w @meetdeck/plugin",
    "dev:extension": "npm run dev -w @meetdeck/extension"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "typescript": "^5.5.0"
  }
}
